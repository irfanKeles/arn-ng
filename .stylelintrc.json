{
  "extends": ["stylelint-config-standard"],
  "plugins": ["stylelint-use-logical"],
  "rules": {
    "no-empty-source": null,
    "declaration-no-important": true,
    "selector-pseudo-element-disallowed-list": ["ng-deep"],
    "csstools/use-logical": "always",
    "property-disallowed-list": ["/^(margin|padding|border)-(left|right)/", "left", "right"],
    "declaration-property-value-disallowed-list": {
      "/^(text-align|float|clear)$/": ["left", "right"]
    }
  },
  "overrides": [
    {
      "files": ["projects/ui/**/*.css"],
      "rules": {
        "custom-property-pattern": [
          "^arn-[a-z0-9]+(-[a-z0-9]+)*$",
          { "message": "Token adı --arn-<bileşen>-<özellik>[-<durum>] kalıbında olmalı (SKILL §5)" }
        ]
      }
    }
  ]
}
