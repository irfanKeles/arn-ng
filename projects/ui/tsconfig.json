/* Used by the editor, ESLint and the spec build: entry points resolve to source, not to dist. The library build uses tsconfig.lib.json. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // TypeScript 6 no longer loads every @types package by default; specs need Vitest's globals
    "types": ["vitest/globals"],
    // No baseUrl (deprecated in TypeScript 6): paths resolve against this file's folder
    "paths": {
      "@arn-ng/ui/*": ["./*/src/public-api.ts"]
    }
  }
}
