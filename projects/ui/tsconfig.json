/* Used by the editor, ESLint and the spec build: entry points resolve to source, not to dist. The library build uses tsconfig.lib.json. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // Needed by the Karma (webpack) build: without it the paths resolve against the working directory
    "baseUrl": ".",
    "paths": {
      "@arn-ng/ui/*": ["./*/src/public-api.ts"]
    }
  }
}
