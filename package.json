{
  "name": "arn-ng",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test ui",
    "test:docs": "ng test docs",
    "test:ci": "ng test --watch=false --headless --coverage",
    "build:ui": "ng build ui",
    "build:ui:watch": "ng build ui --watch --configuration development",
    "build:docs": "ng build docs",
    "serve:docs": "ng serve docs",
    "lint": "eslint . && stylelint \"projects/**/*.css\" --allow-empty-input",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "private": true,
  "workspaces": [
    "projects/ui"
  ],
  "engines": {
    "node": "^22.22.3"
  },
  "dependencies": {
    "@angular/animations": "^22.2.6",
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "^22.7.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "ng-packagr": "^22.2.6",
    "playwright": "^1.65.1",
    "prettier": "^3.9.9",
    "shiki": "^4.5.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-use-logical": "^2.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.1.0"
  }
}
