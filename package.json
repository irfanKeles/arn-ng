{
  "name": "arn-ng",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test ui",
    "test:docs": "ng test docs",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "build:ui": "ng build ui",
    "build:ui:watch": "ng build ui --watch --configuration development",
    "build:docs": "ng build docs",
    "serve:docs": "ng serve docs",
    "lint": "eslint . && stylelint \"projects/**/*.css\" --allow-empty-input",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "private": true,
  "workspaces": [
    "projects/ui"
  ],
  "engines": {
    "node": "^22.12.0"
  },
  "dependencies": {
    "@angular/animations": "^21.2.26",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-browser-dynamic": "^21.2.26",
    "@angular/router": "^21.2.26",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.26",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^21.4.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^21.2.7",
    "prettier": "^3.9.9",
    "shiki": "^4.5.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-use-logical": "^2.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
